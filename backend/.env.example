APP_ENV=development
APP_NAME=Engineering Notes API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://blog:change-me@localhost:5432/blog
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
UPLOAD_ROOT=var/uploads
BACKUP_ROOT=var/backups
INITIAL_ADMIN_EMAIL=admin@local.test
INITIAL_ADMIN_PASSWORD=replace-with-a-local-password-of-at-least-12-characters
INITIAL_ADMIN_ROLE=super_admin
PUBLIC_CONTACT_EMAIL=
PUBLIC_GITHUB_URL=
RESTORE_DATABASE_URL=
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
